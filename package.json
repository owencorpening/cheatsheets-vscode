{
  "name": "cheatsheets",
  "displayName": "Cheatsheets",
  "description": "Keep your own Markdown and HTML cheatsheets open in the secondary sidebar while you code.",
  "version": "0.2.0",
  "publisher": "owencorpening",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#4a4f54",
    "theme": "dark"
  },
  "homepage": "https://owensappliedthinking.com/tools/cheatsheets/",
  "repository": {
    "type": "git",
    "url": "https://github.com/owencorpening/cheatsheets-vscode"
  },
  "bugs": {
    "url": "https://github.com/owencorpening/cheatsheets-vscode/issues"
  },
  "keywords": [
    "cheatsheet",
    "cheat sheet",
    "reference",
    "notes",
    "markdown",
    "html",
    "sidebar",
    "secondary sidebar"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx @vscode/vsce package"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "cheatsheets",
          "title": "Cheatsheets",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cheatsheets": [
        {
          "type": "webview",
          "id": "cheatsheets.panel",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "cheatsheets.toggle",
        "title": "Cheatsheets: Toggle Panel"
      },
      {
        "command": "cheatsheets.refresh",
        "title": "Cheatsheets: Refresh"
      }
    ],
    "configuration": {
      "title": "Cheatsheets",
      "properties": {
        "cheatsheets.folder": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the folder that holds your .md and .html cheatsheets. If empty, the first open workspace folder is used."
        }
      }
    },
    "keybindings": [
      {
        "command": "cheatsheets.toggle",
        "key": "ctrl+alt+c",
        "mac": "ctrl+cmd+c"
      }
    ]
  }
}
